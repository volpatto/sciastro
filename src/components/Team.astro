---
import MemberCard from './MemberCard.astro';
import { labelsFor, translate } from '../i18n.js';
import type { BuiltSite } from '../content.js';
import type { Locale } from '../schema.js';
interface Props {
  site: BuiltSite;
  locale: Locale;
}
const { site, locale } = Astro.props;
const { config, members } = site;
const page = { locale };
const l = labelsFor(config, locale);
const faculty = members.filter(
  (person) => person.status === 'active' && person.role === 'faculty',
);
const researchers = members.filter(
  (person) => person.status === 'active' && person.role === 'researcher',
);
const alumni = members.filter((person) => person.status === 'alumni');
const groups = [
  { id: 'faculty', title: l.faculty, members: faculty },
  { id: 'researchers', title: l.researchers, members: researchers },
];
---

<div class="team-sections">
  {groups
    .filter((group) => group.members.length)
    .map((group) => (
      <section id={group.id} class="team-section">
        <h2>{group.title}</h2>
        <div class="member-grid">
          {group.members.map((member) => (
            <MemberCard member={member} locale={page.locale} config={config} />
          ))}
        </div>
      </section>
    ))}
  {members.some(
    (member) => member.role === 'student' && member.status === 'active',
  ) && (
    <section id="students" class="team-section">
      <h2>{l.students}</h2>
      {config.studentLevels.map((level) => {
        const students = members.filter(
          (member) =>
            member.status === 'active' &&
            member.role === 'student' &&
            member.level === level.id,
        );
        return (
          students.length > 0 && (
            <section class="student-level" id={`level-${level.id}`}>
              <h3>{translate(level.label, page.locale)}</h3>
              <div class="member-grid">
                {students.map((member) => (
                  <MemberCard
                    member={member}
                    locale={page.locale}
                    config={config}
                  />
                ))}
              </div>
            </section>
          )
        );
      })}
    </section>
  )}
  {alumni.length > 0 && (
    <section id="alumni" class="team-section">
      <h2>{l.alumni}</h2>
      <div class="member-grid">
        {alumni.map((member) => (
          <MemberCard member={member} locale={page.locale} config={config} />
        ))}
      </div>
    </section>
  )}
</div>
