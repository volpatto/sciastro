---
import type { Member, Locale, SiteConfig } from '../schema.js';
import { assetPath, translate, labels } from '../i18n.js';
import academicSymbol from '../assets/academic-symbol.svg?raw';
interface Props {
  member: Member;
  locale: Locale;
  config: SiteConfig;
}
const { member, locale, config } = Astro.props;
const fallback = member.avatarFallback ?? config.people?.avatarFallback;
const position = member.photo?.position ?? [50, 50];
const level = config.studentLevels.find((entry) => entry.id === member.level);
---

<article class="member-card" id={`member-${member.id}`}>
  {member.photo ? (
    <span class="avatar avatar-photo">
      <img
        src={assetPath(config.base, member.photo.src)}
        alt={translate(member.photo.alt, locale)}
        style={`object-position: ${position[0]}% ${position[1]}%`}
        width="72"
        height="72"
        loading="lazy"
        decoding="async"
      />
    </span>
  ) : (
    <span class="avatar avatar-fallback">
      {fallback?.viewBox ? (
        <svg
          viewBox={fallback.viewBox}
          role="img"
          aria-label={translate(fallback.alt, locale)}
        >
          <image
            href={assetPath(config.base, fallback.src)}
            width={fallback.width}
            height={fallback.height}
          />
        </svg>
      ) : fallback ? (
        <img
          src={assetPath(config.base, fallback.src)}
          alt={translate(fallback.alt, locale)}
          width="72"
          height="72"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <Fragment set:html={academicSymbol} />
      )}
    </span>
  )}
  <div class="member-description">
    <h3>{member.name}</h3>
    {member.affiliation && (
      <p class="member-affiliation">{translate(member.affiliation, locale)}</p>
    )}
    {member.topic && <p>{translate(member.topic, locale)}</p>}
    {member.status === 'alumni' && level && (
      <p class="member-level">{translate(level.label, locale)}</p>
    )}
    {member.startYear && (
      <small>
        {member.endYear
          ? `${member.startYear}–${member.endYear}`
          : `${labels[locale].since} ${member.startYear}`}
      </small>
    )}
    {member.links.length > 0 && (
      <div class="member-links">
        {member.links.map((link) => (
          <a href={link.url}>{link.label} ↗</a>
        ))}
      </div>
    )}
  </div>
</article>
