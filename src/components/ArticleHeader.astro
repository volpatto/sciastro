---
import type { BuiltPage } from '../content.js';
import { displayDate } from '../navigation.js';
interface Props {
  page: BuiltPage;
}
const { page } = Astro.props;
---

<header class="page-heading article-heading">
  <h1>{page.heading ?? page.title}</h1>
  {(Boolean(page.date) || (page.authors?.length ?? 0) > 0) && (
    <p class="article-metadata">
      {page.date && (
        <time datetime={page.date}>{displayDate(page.date, page.locale)}</time>
      )}
      {page.date && page.authors?.length ? (
        <span aria-hidden="true">·</span>
      ) : null}
      {page.authors?.length ? <span>{page.authors.join(', ')}</span> : null}
    </p>
  )}
  {page.description && <p class="article-description">{page.description}</p>}
  {page.tags?.length ? (
    <ul
      class="article-tags"
      aria-label={page.locale === 'pt' ? 'Temas' : 'Topics'}
    >
      {page.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  ) : null}
</header>
