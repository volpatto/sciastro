---
import '@fontsource-variable/manrope/index.css';
import '@fontsource-variable/newsreader/index.css';
import '../styles/site.css';
import '../styles/sections.css';
import '../styles/lncc.css';
import '../styles/document.css';
import '../styles/articles.css';
import '../styles/experience.css';
import '../styles/navigation.css';
import '../styles/appearance.css';
import '../styles/glass-navigation.css';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import Navigation from './Navigation.astro';
import SciAstroMark from '../assets/sciastro-monogram.svg';
import iconLicenses from '../../docs/icon-licenses.txt?raw';
import fontLicenses from '../../docs/font-licenses.txt?raw';
import type { BuiltSite, BuiltPage } from '../content.js';
import { navigationTree } from '../navigation.js';
import { resolveIcon } from '../icons.js';
import { resolveAppearance } from '../appearance.js';
import {
  translate,
  labelsFor,
  routePath,
  assetPath,
  linkPath,
} from '../i18n.js';
interface Props {
  site: BuiltSite;
  page: Pick<BuiltPage, 'id' | 'locale' | 'path' | 'title' | 'description'> &
    Partial<Pick<BuiltPage, 'layout' | 'date' | 'authors' | 'tags'>>;
}
const { site, page } = Astro.props;
const { config } = site;
const l = labelsFor(config, page.locale);
const navigation = navigationTree(
  site.pages.filter((item) => item.locale === page.locale),
  page.id,
  config.navigationDepth,
);
const lncc = config.theme === 'lncc';
const navigationMode = config.layout?.navigation ?? (lncc ? 'sidebar' : 'top');
const menuChevron = resolveIcon('lucide:chevron-down', 'Navigation disclosure');
const canonical = new URL(page.path, config.url);
const title =
  page.id === 'home' ? config.name : `${page.title} · ${config.name}`;
const description =
  page.description ?? translate(config.description, page.locale);
const socialImage = site.socialImage;
const appearance = config.appearance;
const resolvedAppearance = resolveAppearance(appearance);
const tokens = (values: Record<string, string>) =>
  Object.entries(values)
    .map(([key, value]) => `--${key}:${value}`)
    .join(';');
// Explicit preferences and the system preference are separate scopes. A partial
// light override must never leak into the automatic dark theme.
const style = appearance
  ? `:root:root[data-design] {${tokens(resolvedAppearance.properties)}}
     :root:root[data-design][data-theme="light"] {${tokens(resolvedAppearance.light)}}
     :root:root[data-design][data-theme="dark"] {${tokens(resolvedAppearance.dark)}}
     @media(prefers-color-scheme:light){:root:root[data-design]:not([data-theme]){${tokens(resolvedAppearance.light)}}}
     @media(prefers-color-scheme:dark){:root:root[data-design]:not([data-theme]){${tokens(resolvedAppearance.dark)}}}`
  : '';
---

<!doctype html>
<html
  lang={page.locale === 'pt' ? 'pt-BR' : 'en'}
  data-design={config.theme}
  data-theme-key={config.themeStorageKey}
  data-navigation={navigationMode}
  data-subnavigation={config.layout?.subnavigation ?? 'inline'}
  data-motion={config.appearance?.motion ?? 'none'}
  data-typography={appearance?.typography}
  data-icon-style={appearance?.icons?.style}
  data-navigation-style={appearance?.navigation}
  data-gradient={appearance?.gradient ? appearance.gradient.style : undefined}
  data-gradient-targets={
    appearance?.gradient ? appearance.gradient.targets.join(' ') : undefined
  }
>
  <head>
    <Fragment set:html={`<!--\n${iconLicenses}\n${fontLicenses}\n-->`} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {config.favicon && (
      <link rel="icon" href={assetPath(config.base, config.favicon)} />
    )}
    <link rel="canonical" href={canonical} />
    {page.id !== '404' &&
      config.locales.map((locale) => (
        <link
          rel="alternate"
          hreflang={locale === 'pt' ? 'pt-BR' : locale}
          href={new URL(routePath(config, page.id, locale), config.url)}
        />
      ))}
    {page.id !== '404' && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={
          new URL(routePath(config, page.id, config.defaultLocale), config.url)
        }
      />
    )}
    <meta
      property="og:type"
      content={page.layout === 'article' ? 'article' : 'website'}
    />
    {page.layout === 'article' && (
      <>
        {page.date && (
          <meta
            property="article:published_time"
            content={`${page.date}T00:00:00Z`}
          />
        )}
        {page.authors?.length ? (
          <meta name="author" content={page.authors.join(', ')} />
        ) : null}
        {page.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={config.name} />
    <meta
      property="og:locale"
      content={page.locale === 'pt' ? 'pt_BR' : 'en_GB'}
    />
    {config.locales
      .filter((locale) => locale !== page.locale)
      .map((locale) => (
        <meta
          property="og:locale:alternate"
          content={locale === 'pt' ? 'pt_BR' : 'en_GB'}
        />
      ))}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage.url} />
        <meta
          property="og:image:alt"
          content={translate(socialImage.alt, page.locale)}
        />
        <meta property="og:image:type" content={socialImage.type} />
        {socialImage.width && (
          <meta property="og:image:width" content={String(socialImage.width)} />
        )}
        {socialImage.height && (
          <meta
            property="og:image:height"
            content={String(socialImage.height)}
          />
        )}
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && (
      <>
        <meta name="twitter:image" content={socialImage.url} />
        <meta
          name="twitter:image:alt"
          content={translate(socialImage.alt, page.locale)}
        />
      </>
    )}
    {config.structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          ...config.structuredData,
          url: new URL(
            routePath(config, 'home', config.defaultLocale),
            config.url,
          ).toString(),
        }).replaceAll('<', '\\u003c')}
      ></script>
    )}
    {style && <style is:inline set:html={style}></style>}
    <script is:inline>
      (() => {
        try {
          const preference = localStorage.getItem(
            document.documentElement.dataset.themeKey || 'sciastro-theme',
          );
          if (preference === 'dark' || preference === 'light')
            document.documentElement.dataset.theme = preference;
        } catch {}
      })();
    </script>
  </head>
  <body data-page={page.id}>
    <a class="skip-link" href="#main">
      {l.skip}
    </a>
    <header class="site-header">
      <div class="container masthead">
        <a class="identity" href={routePath(config, 'home', page.locale)}>
          {config.logo?.viewBox ? (
            <svg
              class:list={[
                'brand-logo',
                { 'monochrome-logo': config.logo.monochrome },
              ]}
              viewBox={config.logo.viewBox}
              role="img"
              aria-label={translate(config.logo.alt, page.locale)}
            >
              <image
                href={assetPath(config.base, config.logo.src)}
                width={config.logo.width}
                height={config.logo.height}
              />
            </svg>
          ) : config.logo ? (
            <img
              class="brand-logo"
              src={assetPath(config.base, config.logo.src)}
              alt={translate(config.logo.alt, page.locale)}
              width="44"
              height="44"
            />
          ) : (
            <SciAstroMark
              class="brand-mark"
              width="44"
              height="35.2"
              aria-hidden="true"
              focusable="false"
            />
          )}
          <span>
            <strong>{config.name}</strong>
            {config.affiliation && (
              <small>{translate(config.affiliation, page.locale)}</small>
            )}
          </span>
        </a>
        <div class="header-tools">
          {config.locales.length > 1 && (
            <nav class="languages" aria-label={l.languages}>
              {config.locales.map((locale) => (
                <a
                  href={routePath(
                    config,
                    page.id === '404' ? 'home' : page.id,
                    locale,
                  )}
                  lang={locale}
                  aria-label={locale === 'pt' ? 'Português' : 'English'}
                  aria-current={page.locale === locale ? 'true' : undefined}
                >
                  <Icon
                    icon={site.languageIcons[locale] ?? false}
                    base={config.base}
                  />
                  <span>{locale.toUpperCase()}</span>
                </a>
              ))}
            </nav>
          )}
          <ThemeToggle locale={page.locale} base={config.base} />
        </div>
      </div>
    </header>
    <div
      class:list={[
        'container site-shell',
        {
          'lncc-shell': lncc && navigationMode === 'sidebar',
          'sidebar-shell': navigationMode === 'sidebar',
        },
      ]}
    >
      <aside class="site-navigation">
        <details class="navigation" open>
          <summary>
            {l.menu}
            <Icon icon={menuChevron} base={config.base} />
          </summary>
          <nav aria-label={l.navigation}>
            <Navigation
              nodes={navigation}
              base={config.base}
              locale={page.locale}
              expandActive={navigationMode === 'sidebar'}
            />
          </nav>
        </details>
      </aside>
      <main id="main">
        <slot />
      </main>
    </div>
    <footer class="site-footer container">
      {site.copyright[page.locale] ? (
        <div
          class="footer-primary prose"
          set:html={site.copyright[page.locale]}
        />
      ) : (
        <div class="footer-primary">
          <strong>{config.name}</strong>
        </div>
      )}
      <div class="footer-links">
        {config.links.map((link) => (
          <a
            href={linkPath(config.base, link.url)}
            data-sciastro-event={
              link.analyticsEvent === undefined
                ? undefined
                : String(link.analyticsEvent)
            }
          >
            {link.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a class="footer-brand" href="https://github.com/volpatto/sciastro">
          <SciAstroMark
            class="footer-brand-mark"
            width="26"
            height="20.8"
            aria-hidden="true"
            focusable="false"
          />
          <span>{l.built}</span>
        </a>
      </div>
      {config.notice && (
        <p class="footer-notice">{translate(config.notice, page.locale)}</p>
      )}
      {site.footer[page.locale] && (
        <div class="footer-content prose" set:html={site.footer[page.locale]} />
      )}
    </footer>
    <script>
      const root = document.documentElement;
      const key = root.dataset.themeKey || 'sciastro-theme';
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const system = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : system.matches;
      const sync = () => {
        if (!button) return;
        const dark = isDark();
        button.dataset.themeState = dark ? 'dark' : 'light';
        const label = dark
          ? button.dataset.lightLabel
          : button.dataset.darkLabel;
        if (label) {
          button.setAttribute('aria-label', label);
          button.title = label;
        }
      };
      if (button) {
        sync();
        button.hidden = false;
        system.addEventListener('change', sync);
        button.addEventListener('click', () => {
          root.dataset.theme = isDark() ? 'light' : 'dark';
          try {
            localStorage.setItem(key, root.dataset.theme);
          } catch {}
          sync();
        });
      }
      window.addEventListener('storage', (event) => {
        if (event.key === key || event.key === null) {
          if (event.newValue === 'dark' || event.newValue === 'light')
            root.dataset.theme = event.newValue;
          else delete root.dataset.theme;
          sync();
        }
      });
      const menu = document.querySelector<HTMLDetailsElement>('.navigation');
      // Keep anchor destinations and contextual navigation below a glass bar,
      // including wrapped labels, larger text and the expanded mobile menu.
      if (
        menu &&
        root.dataset.navigation === 'top' &&
        root.dataset.navigationStyle === 'glass'
      ) {
        const offset = () =>
          root.style.setProperty(
            '--top-navigation-offset',
            `${Math.ceil(menu.getBoundingClientRect().height) + 24}px`,
          );
        offset();
        if ('ResizeObserver' in window)
          new ResizeObserver(offset).observe(menu);
      }
      const desktop = matchMedia(
        root.dataset.navigation === 'sidebar'
          ? '(min-width: 851px)'
          : '(min-width: 760px)',
      );
      if (menu) {
        const popoverMode = () =>
          root.dataset.navigation === 'top' && desktop.matches;
        const closePopovers = () => {
          if (!popoverMode()) return;
          menu
            .querySelectorAll<HTMLDetailsElement>('.navigation-branch[open]')
            .forEach((branch) => {
              branch.open = false;
            });
        };
        const syncMenu = () => {
          menu.open = desktop.matches;
        };
        syncMenu();
        desktop.addEventListener('change', syncMenu);
        menu.addEventListener(
          'toggle',
          (event) => {
            const branch = event.target;
            if (
              !popoverMode() ||
              !(branch instanceof HTMLDetailsElement) ||
              !branch.open ||
              !branch.matches(
                '.navigation-tree > .navigation-item > .navigation-branch',
              )
            )
              return;
            menu
              .querySelectorAll<HTMLDetailsElement>(
                '.navigation-tree > .navigation-item > .navigation-branch[open]',
              )
              .forEach((other) => {
                if (other !== branch) other.open = false;
              });
          },
          true,
        );
        menu.addEventListener('focusout', (event) => {
          if (
            event.relatedTarget instanceof Node &&
            !menu.contains(event.relatedTarget)
          )
            closePopovers();
        });
        document.addEventListener('pointerdown', (event) => {
          if (event.target instanceof Node && !menu.contains(event.target))
            closePopovers();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && event.target instanceof Element) {
            const branch =
              event.target.closest<HTMLDetailsElement>(
                '.navigation-branch[open]',
              ) ??
              (popoverMode() && menu.contains(event.target)
                ? menu.querySelector<HTMLDetailsElement>(
                    '.navigation-tree > .navigation-item > .navigation-branch[open]',
                  )
                : null);
            if (branch) {
              branch.open = false;
              branch.querySelector('summary')?.focus();
              return;
            }
          }
          if (event.key === 'Escape' && !desktop.matches && menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      }
      for (const copy of document.querySelectorAll<HTMLButtonElement>(
        '[data-copy-code]',
      )) {
        if (!navigator.clipboard?.writeText) continue;
        copy.hidden = false;
        const originalLabel =
          copy.getAttribute('aria-label') ??
          copy.dataset.copyLabel ??
          'Copy code';
        let reset: ReturnType<typeof setTimeout> | undefined;
        copy.addEventListener('click', async () => {
          const code = copy
            .closest('.document-code')
            ?.querySelector('pre code');
          if (!code) return;
          clearTimeout(reset);
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            copy.textContent = copy.dataset.copiedLabel ?? 'Copied';
          } catch {
            copy.textContent = copy.dataset.copyErrorLabel ?? 'Unable to copy';
          }
          copy.setAttribute('aria-label', copy.textContent);
          reset = setTimeout(() => {
            copy.textContent = copy.dataset.copyLabel ?? 'Copy';
            copy.setAttribute('aria-label', originalLabel);
          }, 2500);
        });
      }
      if (document.body.dataset.page === 'home' && location.hash) {
        const oldSection = location.hash.slice(1);
        const destination = [
          ...document.querySelectorAll<HTMLAnchorElement>('.navigation a'),
        ].find((link) => link.dataset.page === oldSection);
        if (destination && oldSection !== 'home')
          location.replace(destination.href);
      }
    </script>
  </body>
</html>
