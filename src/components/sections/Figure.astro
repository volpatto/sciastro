---
import { assetPath } from '../../i18n.js';
import type { BuiltFigure } from '../../sections.js';
import Links from './Links.astro';
interface Props {
  image: BuiltFigure;
  base: string;
  priority?: boolean;
}
const { image, base, priority = false } = Astro.props;
const src = assetPath(base, image.src);
const Tag = image.enlarge ? 'a' : 'div';
const circular = image.shape === 'circle';
const position = image.position ?? [50, 50];
const captionStyle = image.captionAlign
  ? `--figure-caption-align:${image.captionAlign};--figure-caption-links-align:${image.captionAlign === 'center' ? 'center' : image.captionAlign === 'right' ? 'flex-end' : 'flex-start'}`
  : undefined;
---

<figure
  class:list={[
    'sp-figure',
    { 'sp-figure-cropped': image.viewBox, 'sp-figure-circle': circular },
  ]}
>
  <Tag
    class="sp-figure-media"
    href={image.enlarge ? src : undefined}
    aria-label={image.enlarge ? image.alt : undefined}
  >
    {image.viewBox ? (
      <svg
        viewBox={image.viewBox}
        role="img"
        aria-label={image.alt}
        preserveAspectRatio={circular ? 'xMidYMid slice' : undefined}
      >
        <image href={src} width={image.width} height={image.height} />
      </svg>
    ) : (
      <img
        src={src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        style={
          circular
            ? `object-position: ${position[0]}% ${position[1]}%`
            : undefined
        }
      />
    )}
  </Tag>
  {(image.caption || image.links.length > 0) && (
    <figcaption style={captionStyle}>
      {image.caption}
      <Links links={image.links} base={base} />
    </figcaption>
  )}
</figure>
